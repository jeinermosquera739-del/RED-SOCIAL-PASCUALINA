        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#9ca3af;fillColor=#f9fafb;align=left;verticalAlign=top;spacing=6" value="&lt;table border=&quot;0&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;font-family:Arial;font-size:10px&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-weight:bold;font-size:12px&quot;&gt;Leyenda de símbolos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:15px;text-align:center&quot;&gt;🔑&lt;/td&gt;&lt;td&gt;&lt;b&gt;PK -- Primary Key&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:15px;text-align:center&quot;&gt;◆&lt;/td&gt;&lt;td&gt;&lt;b&gt;FK&lt;/b&gt; — Foranesa Key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:15px;text-align:center&quot;&gt;◇&lt;/td&gt;&lt;td&gt;&lt;b&gt;UK&amp;nbsp; &amp;nbsp;&lt;/b&gt;— Clave única&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:15px;text-align:center&quot;&gt;🔑 ◆&lt;/td&gt;&lt;td&gt;&lt;b&gt;PK + FK&lt;/b&gt; — Clave primaria y foránea&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:15px;text-align:center&quot;&gt;◆ ◇&lt;/td&gt;&lt;td&gt;&lt;b&gt;FK + UK&lt;/b&gt; — Foránea y única&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
